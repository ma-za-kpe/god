{
  "_meta": {
    "title": "Flux Portrait Genesis - IP-Adapter FaceID",
    "description": "Generates a canonical portrait using Flux model with IP-Adapter FaceID for character consistency. Archetype-styled face generation from style prompt.",
    "version": "1.0.0",
    "required_custom_nodes": [
      "ComfyUI-IPAdapter-Plus",
      "ComfyUI-Flux",
      "comfyui_controlnet_aux",
      "ComfyUI-KJNodes"
    ],
    "required_models": {
      "checkpoint": "flux1-dev.safetensors",
      "ip_adapter": "ip-adapter-faceid-plusv2_sd15.bin",
      "clip_vision": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors",
      "insightface": "buffalo_l"
    },
    "placeholder_tokens": {
      "{{STYLE_PROMPT}}": "Archetype style prompt (max 500 chars) - filled at runtime from ArchetypeStyleConfig",
      "{{NEGATIVE_PROMPT}}": "Negative prompt for quality control",
      "{{SEED}}": "Integer seed for reproducibility",
      "{{WIDTH}}": "Output width in pixels (min 512)",
      "{{HEIGHT}}": "Output height in pixels (min 512)",
      "{{BATCH_SIZE}}": "Number of images to generate (default 1)"
    }
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "flux1-dev.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{STYLE_PROMPT}}",
      "clip": ["1", 1]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{NEGATIVE_PROMPT}}",
      "clip": ["1", 1]
    }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "batch_size": "{{BATCH_SIZE}}"
    }
  },
  "5": {
    "class_type": "IPAdapterFaceID",
    "inputs": {
      "model": ["1", 0],
      "ipadapter": "ip-adapter-faceid-plusv2_sd15.bin",
      "clip_vision": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors",
      "insightface": "buffalo_l",
      "weight": 0.85,
      "weight_type": "linear",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["5", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0],
      "seed": "{{SEED}}",
      "steps": 28,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["6", 0],
      "vae": ["1", 2]
    }
  },
  "8": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["7", 0],
      "filename_prefix": "genesis_portrait"
    }
  }
}
