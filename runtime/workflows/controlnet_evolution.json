{
  "_meta": {
    "title": "ControlNet Evolution - Scar and Prestige Layering",
    "description": "Applies localized evolution edits on top of the canonical portrait while preserving face identity through IP-Adapter reference guidance.",
    "version": "1.0.0",
    "required_custom_nodes": [
      "ComfyUI-ControlNet",
      "ComfyUI-IPAdapter-Plus",
      "comfyui_controlnet_aux",
      "ComfyUI-Flux",
      "ComfyUI-KJNodes"
    ],
    "required_models": {
      "checkpoint": "flux1-dev.safetensors",
      "controlnet": "controlnet_union_sd15.safetensors",
      "ip_adapter": "ip-adapter-faceid-plusv2_sd15.bin",
      "clip_vision": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors",
      "insightface": "buffalo_l"
    },
    "placeholder_tokens": {
      "{{REFERENCE_IMAGE_PATH}}": "Canonical portrait or evolved portrait used as the identity reference",
      "{{CONTROL_PROMPT}}": "Edit prompt describing the scar, softening, or prestige mark",
      "{{NEGATIVE_PROMPT}}": "Negative prompt for quality control",
      "{{SEED}}": "Integer seed for reproducibility",
      "{{WIDTH}}": "Output width in pixels (min 512)",
      "{{HEIGHT}}": "Output height in pixels (min 512)"
    }
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "flux1-dev.safetensors"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{REFERENCE_IMAGE_PATH}}"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{CONTROL_PROMPT}}",
      "clip": ["1", 1]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{NEGATIVE_PROMPT}}",
      "clip": ["1", 1]
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "controlnet_union_sd15.safetensors"
    }
  },
  "7": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "conditioning": ["3", 0],
      "control_net": ["6", 0],
      "image": ["2", 0],
      "strength": 0.65
    }
  },
  "8": {
    "class_type": "IPAdapterFaceID",
    "inputs": {
      "model": ["1", 0],
      "image": ["2", 0],
      "ipadapter": "ip-adapter-faceid-plusv2_sd15.bin",
      "clip_vision": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors",
      "insightface": "buffalo_l",
      "weight": 0.90,
      "weight_type": "linear",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["8", 0],
      "positive": ["7", 0],
      "negative": ["4", 0],
      "latent_image": ["5", 0],
      "seed": "{{SEED}}",
      "steps": 30,
      "cfg": 4.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.75
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["9", 0],
      "vae": ["1", 2]
    }
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["10", 0],
      "filename_prefix": "evolution_controlnet"
    }
  }
}
