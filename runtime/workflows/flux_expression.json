{
  "_meta": {
    "title": "Flux Expression Variant - IP-Adapter Reference",
    "description": "Generates expression variants (neutral, angry, playful, calm, intense, vulnerable, flinch) using the canonical portrait as IP-Adapter reference for identity preservation.",
    "version": "1.0.0",
    "required_custom_nodes": [
      "ComfyUI-IPAdapter-Plus",
      "ComfyUI-Flux",
      "comfyui_controlnet_aux",
      "ComfyUI-KJNodes",
      "ComfyUI-Image-Loader"
    ],
    "required_models": {
      "checkpoint": "flux1-dev.safetensors",
      "ip_adapter": "ip-adapter-faceid-plusv2_sd15.bin",
      "clip_vision": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors",
      "insightface": "buffalo_l"
    },
    "placeholder_tokens": {
      "{{EXPRESSION_PROMPT}}": "Expression-specific prompt (e.g. 'portrait with angry fierce expression, furrowed brows')",
      "{{NEGATIVE_PROMPT}}": "Negative prompt for quality control",
      "{{SEED}}": "Integer seed for reproducibility",
      "{{WIDTH}}": "Output width in pixels (min 512)",
      "{{HEIGHT}}": "Output height in pixels (min 512)",
      "{{REFERENCE_IMAGE_PATH}}": "File path or base64 of the canonical portrait used as IP-Adapter reference",
      "{{IP_ADAPTER_WEIGHT}}": "IP-Adapter weight for identity fidelity (0.7-0.95, default 0.85)",
      "{{EXPRESSION_NAME}}": "Name of the expression variant being generated"
    },
    "supported_expressions": [
      "neutral",
      "angry",
      "playful",
      "calm",
      "intense",
      "vulnerable",
      "flinch"
    ]
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "flux1-dev.safetensors"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{REFERENCE_IMAGE_PATH}}"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{EXPRESSION_PROMPT}}",
      "clip": ["1", 1]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{NEGATIVE_PROMPT}}",
      "clip": ["1", 1]
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "IPAdapterFaceID",
    "inputs": {
      "model": ["1", 0],
      "image": ["2", 0],
      "ipadapter": "ip-adapter-faceid-plusv2_sd15.bin",
      "clip_vision": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors",
      "insightface": "buffalo_l",
      "weight": "{{IP_ADAPTER_WEIGHT}}",
      "weight_type": "linear",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["6", 0],
      "positive": ["3", 0],
      "negative": ["4", 0],
      "latent_image": ["5", 0],
      "seed": "{{SEED}}",
      "steps": 28,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["7", 0],
      "vae": ["1", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["8", 0],
      "filename_prefix": "expression_{{EXPRESSION_NAME}}"
    }
  }
}
