MERGE (n:AnatomyNode:Structure:Aggregate {id: 'aggregate:brain_case_bones'}) SET n = {aliases: ['neurocranium'], control_channels: [], id: 'aggregate:brain_case_bones', kind: 'structure', label: 'Brain-case bones', llm_visible: false, materialization: 'aggregate', source_ids: ['openstax-ap-2e-7.2']};
