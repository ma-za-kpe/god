MATCH (from:AnatomyNode {id: 'bone:right_hallux_proximal_phalanx'}) MATCH (to:AnatomyNode {id: 'digit:right_hallux'}) MERGE (from)-[r:PART_OF {graph_key: 'bone:right_hallux_proximal_phalanx|PART_OF|digit:right_hallux|000064'}]->(to) SET r += {graph_key: 'bone:right_hallux_proximal_phalanx|PART_OF|digit:right_hallux|000064', kind: 'part_of', source_ids: ['openstax-ap-2e-8.4']};
MATCH (from:AnatomyNode {id: 'bone:right_hallux_distal_phalanx'}) MATCH (to:AnatomyNode {id: 'digit:right_hallux'}) MERGE (from)-[r:PART_OF {graph_key: 'bone:right_hallux_distal_phalanx|PART_OF|digit:right_hallux|000065'}]->(to) SET r += {graph_key: 'bone:right_hallux_distal_phalanx|PART_OF|digit:right_hallux|000065', kind: 'part_of', source_ids: ['openstax-ap-2e-8.4']};
MATCH (from:AnatomyNode {id: 'skin:right_hallux'}) MATCH (to:AnatomyNode {id: 'organ:skin'}) MERGE (from)-[r:PART_OF {graph_key: 'skin:right_hallux|PART_OF|organ:skin|000066'}]->(to) SET r += {graph_key: 'skin:right_hallux|PART_OF|organ:skin|000066', kind: 'part_of', source_ids: ['fipat-ta2-2019']};
MATCH (from:AnatomyNode {id: 'skin:right_hallux'}) MATCH (to:AnatomyNode {id: 'digit:right_hallux'}) MERGE (from)-[r:LOCATED_IN {graph_key: 'skin:right_hallux|LOCATED_IN|digit:right_hallux|000067'}]->(to) SET r += {graph_key: 'skin:right_hallux|LOCATED_IN|digit:right_hallux|000067', kind: 'located_in', source_ids: ['fipat-ta2-2019']};
// Anatomy validation queries
MATCH (n:AnatomyNode) WHERE n.id IS NULL OR n.label IS NULL OR n.kind IS NULL OR n.materialization IS NULL OR n.source_ids IS NULL RETURN count(n) AS invalid_node_count;
MATCH ()-[r]->() WHERE r.graph_key IS NULL OR r.kind IS NULL OR r.source_ids IS NULL RETURN count(r) AS invalid_relationship_count;
MATCH (n:AnatomyNode) RETURN count(n) AS node_count, 60 AS expected_nodes;
MATCH ()-[r]->() RETURN count(r) AS relationship_count, 68 AS expected_relationships;
MATCH (n:AnatomyNode) WITH n.id AS id, count(n) AS copies WHERE copies > 1 RETURN count(id) AS duplicate_node_id_count;
