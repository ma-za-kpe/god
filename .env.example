# God Project — Environment Variables (OPEN SOURCE — placeholders only)
# Copy to .env.local and fill in locally. NEVER commit .env.local or real keys.

# ─── Blockchain ───────────────────────────────────────────────────────────
# Free RPC endpoints: https://alchemy.com, https://infura.io, https://portal.cdp.coinbase.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ─── Database ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=localdev_change_me_in_production

# ─── AI / LLM (for agent cognition) ──────────────────────────────────────
# At least one of these is required for agent reasoning
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=
BANTER_REMOTE_PROVIDER=groq
BANTER_REMOTE_MODEL=llama-3.1-70b-versatile
BANTER_REMOTE_API_KEY=
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ─── Twitch (get these from dev.twitch.tv/console) ──────────────────────────
# 1. Create an Application → get CLIENT_ID + CLIENT_SECRET
# 2. Generate a User Access Token for your bot account (scopes: chat:edit chat:read)
#    via https://twitchapps.com/tmi/ or the OAuth flow
# 3. BROADCASTER_ID = numeric Twitch user ID of the channel (not the bot)
# 4. BOT_USER_ID = numeric Twitch user ID of the bot account sending chat
# 5. STREAM_KEY is in Twitch Dashboard → Settings → Stream → Primary Stream Key
#    (never commit this — it gives full stream access)
TWITCH_ENABLED=false
TWITCH_DRY_RUN=true
TWITCH_EVENTSUB_TRANSPORT=websocket
TWITCH_CHANNEL_NAME=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=
TWITCH_BOT_USER_ID=
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=
# Health probe URLs (leave blank to skip health checks)
TWITCH_HELIX_HEALTH_URL=https://api.twitch.tv/helix/
TWITCH_EVENTSUB_HEALTH_URL=https://eventsub.wss.twitch.tv/ws
# ─── YouTube Live (get these from console.cloud.google.com) ─────────────────
# 1. Create a project → enable YouTube Data API v3
# 2. OAuth 2.0 credentials → download client_secret.json → get CLIENT_ID + CLIENT_SECRET
# 3. Run: gcloud auth application-default login --scopes=https://www.googleapis.com/auth/youtube.force-ssl
#    or use twitch-style token helper → copy ACCESS_TOKEN + REFRESH_TOKEN
# 4. CHANNEL_ID = your channel's UCxxxxxxxx ID (youtube.com/channel/<id>)
# 5. API_KEY = optional server key for read-only probes (no user auth required)
YOUTUBE_ENABLED=false
YOUTUBE_DRY_RUN=true
YOUTUBE_TRANSPORT=polling
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_HEALTH_URL=https://www.googleapis.com/youtube/v3/
YOUTUBE_AUTO_GO_LIVE=false
YOUTUBE_BROADCAST_ID=
YOUTUBE_GO_LIVE_TIMEOUT_S=90
YOUTUBE_GO_LIVE_POLL_S=5
# ─── OBS WebSocket v5 ────────────────────────────────────────────────────────
# Tools → WebSocket Server Settings in OBS → enable, set password
OBS_ENABLED=false
OBS_WEBSOCKET_URL=ws://localhost:4455
OBS_WEBSOCKET_PASSWORD=
OBS_SCENE_PREFIX=obs/
BROADCAST_TRANSPORT=dry-run
BROADCAST_ENABLED=true
BROADCAST_DRY_RUN=true
OBS_BROWSER_SOURCE=god-browser
OBS_BROWSER_URL=http://localhost:10517/one
OBS_BROWSER_WIDTH=1920
OBS_BROWSER_HEIGHT=1080
OBS_AUTO_START_STREAM=false
OBS_STREAM_SERVER=rtmp://a.rtmp.youtube.com/live2
OBS_STREAM_KEY=
# ─── NeMo ────────────────────────────────────────────────────────────────────
NEMO_ENABLED=true
NEMO_ENDPOINT=
NEMO_PROVIDER=stub
NEMO_MODE=director
NEMO_GUARDRAILS=enabled
NEMO_MEMORY=ephemeral
VIEWER_MODE=overlay
VIEWER_TRANSPORT=dry-run
CONTENT_BANK_MODE=deterministic
CONTENT_BANK_HORIZON_DAYS=30
CONTENT_BANK_TRANSPORT=local-pre-gen
VOICE_ENABLED=false
VOICE_HEALTH_URL=
VOICE_PROVIDER=kokoro
VOICE_MODEL=kokoro
VOICE_NAME=narrator
VOICE_PROFILE=dramatic
VOICE_SPEED=1.0
VOICE_PITCH=0.5
VOICE_SAMPLE_RATE=48000
VOICE_TRANSPORT=local-tts
VOICE_DRY_RUN=true
VOICE_SYNTHESIS_ENABLED=true
VOICE_PLAYBACK_MODE=browser+sink
VOICE_RENDER_TARGET=obs-audio
VOICE_DIALOGUE_MAX_AGE_SECONDS=20
LIP_SYNC_SOURCE=audio
AVATAR_ENABLED=false
AVATAR_HEALTH_URL=
AVATAR_RENDERER=vrm
AVATAR_FORMAT=vrm
AVATAR_ASSET=
AVATAR_RENDER_TARGET=obs-virtual-camera
AVATAR_TRANSPORT=local-avatar
AVATAR_DRY_RUN=true
AVATAR_LIP_SYNC_SOURCE=audio
# ─── Optional: LangSmith tracing (helps debug agent graphs) ───────────────
# Sign up free at https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=god-local

# ─── Security / deployment mode ─────────────────────────────────────────
# Local dev: keep services local, but creator/admin HTTP actions still require a token.
LOCAL_DEV_MODE=true
ALLOW_INSECURE_LOCAL_ENDPOINTS=false
ALLOW_TOKENLESS_CREATOR=false
# Set a strong local token and pass it as X-Creator-Token for creator/admin actions.
CREATOR_GENESIS_TOKEN=change-me-local-dev

# ─── IPFS (Law 2 — death archives pinned to ≥3 nodes) ───────────────────
IPFS_API=http://localhost:5001
IPFS_API_ENDPOINTS=http://localhost:5001,http://localhost:5002,http://localhost:5003
MIN_IPFS_PINS=3
IPFS_PIN_RETRIES=3
IPFS_PIN_TIMEOUT_S=15

# ─── On-chain rent (local Anvil — after forge deploy) ───────────────────
ANVIL_RPC=http://localhost:8545
RENT_COLLECTOR_ADDRESS=
SOUL_NFT_ADDRESS=
USDC_ADDRESS=
# Anvil account #0 — NEVER use in production
CREATOR_PRIVATE_KEY=
RENT_AMOUNT_USDC=0.001
MUTATION_COST_USDC=0.002
TOKEN_DEPLOY_FEE_USDC=1.0

# ─── x402 service bridge ────────────────────────────────────────────────
RUNTIME_BASE_URL=http://localhost:8888
RUNTIME_URL=http://localhost:8888
VITE_RUNTIME_URL=http://localhost:8888
MOCK_X402_PAYMENTS=false
USE_X402_FOR_BUY_SERVICE=true
CHAIN_NETWORK=base-sepolia
ENABLE_EXTERNAL_FETCH=false
SERVICE_SELLER_SHARE=0.9
MESSAGE_COST_DIRECT_USDC=0.001
MESSAGE_COST_BROADCAST_USDC=0.01
INBOX_MAX_PULL=10

# ─── Avatar Genesis Pipeline ─────────────────────────────────────────
# ComfyUI sidecar for Flux image generation (portraits + expressions)
COMFYUI_ENDPOINT=http://comfyui:8188
# Fish Speech / CosyVoice sidecar for voice cloning
TTS_ENDPOINT=http://fish-speech:7860
# Max total pipeline execution time per agent (seconds)
PIPELINE_TIMEOUT_SECONDS=300
# Max concurrent ComfyUI requests (1-16)
COMFYUI_CONCURRENCY=2
# Max concurrent TTS requests (1-16)
TTS_CONCURRENCY=4
# Duration (seconds) for vulnerable expression after CRACK beat (15-40)
CRACK_EXPRESSION_DURATION_SECONDS=25
# Duration (seconds) for flinch expression after landed hit (5-15)
FLINCH_EXPRESSION_DURATION_SECONDS=8
# Enable/disable portrait evolution (scar/soften/prestige)
AVATAR_EVOLUTION_ENABLED=true
# Enable/disable genesis pipeline on agent seed
AVATAR_GENESIS_ENABLED=true
WORLD_ID=local-dev-world-1
DATABASE_URL=postgresql://god:localdev@localhost:5432/god_world
NATS_URL=nats://nats:4222
REDIS_URL=redis://redis:6379
AGENT_CYCLE_SECONDS=12
JOBS_TICK_S=15
WS_SNAPSHOT_INTERVAL_S=8
AGENTS_MAX_LIMIT=10000
SNAPSHOT_MAX_AGENTS=10000
MAX_ACTIONS_PER_HOUR=120
MAX_MESSAGES_PER_HOUR=120
MAX_LLM_CALLS_PER_HOUR=360
BREAKER_COOLDOWN_S=45
REPRO_PROB=0.08
MATING_COST_USDC=0.001
CHILD_SEED_USDC=0.002
RECOVERY_CYCLES=3
RENT_PERIOD_SECONDS=300
MUTATION_RATE=0.05
ARCHETYPE_MUTATION_PROB=0.10
REPRO_MIN_MULT=5.0
REPRO_TOP_FRACTION=0.15
REPRO_MIN_PEER_EARNED_USDC=0.005
REPRO_MAX_POPULATION=32
REPRO_RANK_WINDOW_DAYS=30
STATUS_REVIEW_DAYS=7
WALLET_STORE_PATH=data/agent_wallets.json
LLM_CONCURRENCY=4
VOICE_PLAYBACK_MODE=browser+sink
VOICE_RENDER_TARGET=obs-audio
VOICE_DIALOGUE_MAX_AGE_SECONDS=20
AVATAR_RENDER_TARGET=obs-virtual-camera
AVATAR_TRANSPORT=local-avatar
AVATAR_DRY_RUN=true
AVATAR_LIP_SYNC_SOURCE=audio

# ─── Production only (leave blank for local dev) ─────────────────────────
PINATA_JWT=
FILEBASE_KEY=
CREATOR_WALLET_ADDRESS=
CREATOR_GENESIS_TOKEN=
